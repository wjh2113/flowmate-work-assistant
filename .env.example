# 服务端专用；不要使用 VITE_ 前缀，也不要提交真实密钥
DASHSCOPE_API_KEY=sk-your-bailian-key-here
QWEN_TEXT_MODEL=qwen3.7-plus
QWEN_ASR_MODEL=qwen3-asr-flash
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DEEPSEEK_API_KEY=sk-your-deepseek-key
# MOONSHOT_API_KEY=sk-your-moonshot-kimi-key

# 必填：本机 / 服务器 PostgreSQL
DATABASE_URL=postgres://flowmate:CHANGE_ME@127.0.0.1:5432/flowmate
# 仅 setup 脚本用（Windows 常需带 postgres 超级用户密码）
# PG_ADMIN_URL=postgres://postgres:ADMIN_PASS@127.0.0.1:5432/postgres
# FLOWMATE_DB_PASSWORD=CHANGE_ME

# 唯一超级管理员（账号默认 jonny）。哈希在 setup 时生成，不要把明文密码写入仓库。
# 可覆盖 server/admin-bootstrap.json；轮换：把新密码 pipe 给 node scripts/hash-admin-password.mjs，将输出的 salt:hash 写入下面或 json 后重启。
# ADMIN_BOOTSTRAP_USER=jonny
# ADMIN_BOOTSTRAP_PASSWORD_HASH=salt:hash
# DEFAULT_SIGNUP_POINTS=50000

# Supabase 前端公钥（Anon/Publishable key 可以公开，权限由 RLS 控制）
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
PORT=8787
